{
  "mcpServers": {
    "kosli": {
      "command": "npx",
      "args": ["-y", "@kosli/mcp-server@0.7.0"],
      "env": {
        "KOSLI_API_TOKEN": "${KOSLI_API_TOKEN}",
        "KOSLI_BASE_URL": "${KOSLI_BASE_URL:-https://app.kosli.com}"
      }
    },
    "harness": {
      "command": "npx",
      "args": ["-y", "harness-mcp-v2@3.2.39"],
      "env": {
        "HARNESS_API_KEY": "${HARNESS_API_KEY}",
        "HARNESS_READ_ONLY": "true"
      }
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana==2.2.0", "--disable-write"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    }
  }
}
